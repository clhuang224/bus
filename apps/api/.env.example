DATABASE_URL="your-database-url-here"
ADMIN_API_KEY="replace-with-a-long-random-value"
TDX_CLIENT_ID="your-tdx-client-id-here"
TDX_CLIENT_SECRET="your-tdx-client-secret-here"
# Optional: comma-separated browser origins allowed to call the API.
# CORS_ORIGINS="https://your-account.github.io"
# Optional: limit base-data sync to selected TDX city names during local testing.
# SYNC_CITIES="Taipei,NewTaipei"
# Optional: maximum TDX realtime requests per second from this API (default 3).
# The TDX key's per-second limit is shared with sync and the TDX proxy, so the
# default leaves headroom for them; raise it once the proxy is retired.
# TDX_REALTIME_REQUESTS_PER_SECOND="3"
